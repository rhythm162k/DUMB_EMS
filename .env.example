# Copy this file to .env at the repository root and replace the password.
NODE_ENV=development
PORT=3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=ems_dev
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=ems_dev

# After starting PostgreSQL, run these from the repository root:
# npm run db:setup
# npm run db:seed
# Note: /api/v1/ready checks the PostgreSQL connection, not whether tables exist.

# Authentication/session security. Generate a unique secret with:
# openssl rand -base64 48
SESSION_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=8
BCRYPT_COST=12
WEB_ORIGIN=http://localhost:5173

# Optional: private folder for profile photos. Defaults to <repo>/storage/profile-images.
# PROFILE_IMAGE_DIR=
